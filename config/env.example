# Personal AI Assistant — Environment Variables
# Copy this file to ~/.openclaw/.env and fill in your values.
# NEVER commit the real .env file to git.

# ── Telegram ────────────────────────────────────────────────────
# Get this from @BotFather on Telegram (see setup guide)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# ── Cloud API (Phase 1 — optional until then) ──────────────────
# Get from https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Google APIs (Phase 2-3) ─────────────────────────────────────
# These are set up automatically by OAuth flow — don't edit manually
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
